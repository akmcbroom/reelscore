---
/**
 * Home page — Multi-source blended discovery feed.
 * Single unified grid blending 6 TMDB Discover sources:
 *   Movies: Popular, Now Playing, Top Rated, Upcoming
 *   TV: Popular (newest first), Top Rated
 * All sources fetched in parallel, blended via blendAndDedup,
 * scored via single getScoresBatched call.
 * See CLAUDE.md Discovery Feed (Home Page).
 */

import Layout from "../layouts/Layout.astro";
import TitleCard from "../components/TitleCard.astro";
import FeedSection from "../components/FeedSection.astro";
import {
  getPopularMovies,
  getNowPlayingMovies,
  getTopRatedMovies,
  getUpcomingMovies,
  getPopularTV,
  getTopRatedTV,
  blendAndDedup,
  getDisplayTitle,
  getReleaseDate,
} from "../lib/tmdb.ts";
import { getScoresBatched } from "../lib/mdblist.ts";
import { calculateReelScore } from "../lib/scoring.ts";
import { env } from "cloudflare:workers";

const apiKey = env.TMDB_API_KEY;
const mdblistKey = env.MDBLIST_API_KEY;
const kv = env.SCORE_CACHE;

// --- Fetch all 6 sources in parallel ---
// 1 page from each source (6 TMDB calls, ~120 raw items).
// After dedup + anime filter, take 60 for the grid.
const [popularMovies, nowPlaying, topRatedMovies, upcoming, popularTV, topRatedTV] =
  await Promise.all([
    getPopularMovies(apiKey, 1),
    getNowPlayingMovies(apiKey, 1),
    getTopRatedMovies(apiKey, 1),
    getUpcomingMovies(apiKey, 1),
    getPopularTV(apiKey, 1),
    getTopRatedTV(apiKey, 1),
  ]);

// --- Blend all sources into a single grid ---
// blendAndDedup: flatten → dedup by ID → anime filter → exclude → sort by popularity
const gridItems = blendAndDedup(
  [
    popularMovies?.results ?? [],
    nowPlaying?.results ?? [],
    topRatedMovies?.results ?? [],
    upcoming?.results ?? [],
    popularTV?.results ?? [],
    topRatedTV?.results ?? [],
  ],
  new Set()
);
// 60 items = LCM(2,3,4,5,6) — fills complete rows at every breakpoint
gridItems.length = Math.min(gridItems.length, 60);

// --- Score everything in one batch ---
const scoreInputs = gridItems.map((item) => ({
  tmdbId: item.id,
  mediaType: (item.media_type ?? "movie") as "movie" | "tv",
  releaseDate: getReleaseDate(item) ?? null,
}));

const allScoreData = await getScoresBatched(kv, mdblistKey, scoreInputs);

const gridScored = gridItems.map((item, i) => {
  const scoreData = allScoreData[i];
  const result = scoreData ? calculateReelScore(scoreData.scores) : null;
  return {
    item,
    score: result?.score ?? null,
    sources: result?.sources ?? [],
  };
});

// Build exclude list for page 2+ cross-dedup (comma-separated TMDB IDs).
// All 60 grid IDs so nothing from page 1 reappears in infinite scroll.
const excludeParam = gridItems.map((item) => item.id).join(",");
---

<Layout title="Home">
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {/* --- Multi-Source Blended Grid --- */}
    {/* 6 Discover sources blended, deduped, anime-filtered, sorted by popularity.
        The exclude param passes all page 1 IDs to page 2+ requests
        so the feed API can continue filtering them out. */}

    <FeedSection
      title="Discover"
      section="feed"
      loadMoreUrl={`/api/feed?page=2&exclude=${excludeParam}`}
    >
      {gridScored.map(({ item, score, sources }) => (
        <TitleCard
          tmdbId={item.id}
          title={getDisplayTitle(item)}
          posterPath={item.poster_path}
          mediaType={(item.media_type ?? "movie") as "movie" | "tv"}
          releaseDate={getReleaseDate(item)}
          score={score}
          sources={sources}
          voteCount={item.vote_count}
        />
      ))}
    </FeedSection>
  </main>
</Layout>
