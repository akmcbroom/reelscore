---
/**
 * Home page — Hybrid discovery feed.
 * Top: New Releases curated row (Discover movies + TV, US-filtered).
 * Bottom: blended infinite scroll grid (TMDB Popular movies + TV).
 * All data fetched in parallel, scored via single getScoresBatched call.
 * Grid is cross-deduplicated against curated row IDs.
 * See CLAUDE.md Discovery Feed (Home Page).
 */

import Layout from "../layouts/Layout.astro";
import TitleCard from "../components/TitleCard.astro";
import CuratedRow from "../components/CuratedRow.astro";
import FeedSection from "../components/FeedSection.astro";
import {
  getPopularMovies,
  getPopularTV,
  getNewReleaseMovies,
  getNewReleaseTV,
  getDisplayTitle,
  getReleaseDate,
  type TmdbTrendingItem,
} from "../lib/tmdb.ts";
import { getScoresBatched } from "../lib/mdblist.ts";
import { calculateReelScore } from "../lib/scoring.ts";
import { env } from "cloudflare:workers";

const apiKey = env.TMDB_API_KEY;
const mdblistKey = env.MDBLIST_API_KEY;
const kv = env.SCORE_CACHE;

// --- Fetch all data in parallel ---
// New Releases: Discover movies (region=US) + Discover TV (watch_region=US).
// Grid: 3 TMDB pages per type (120 total) to ensure 60 items after
// filtering out curated row IDs.
const [
  newMoviesData,
  newTvData,
  gridMovies1,
  gridMovies2,
  gridMovies3,
  gridTv1,
  gridTv2,
  gridTv3,
] = await Promise.all([
  getNewReleaseMovies(apiKey, 1),
  getNewReleaseTV(apiKey, 1),
  getPopularMovies(apiKey, 1),
  getPopularMovies(apiKey, 2),
  getPopularMovies(apiKey, 3),
  getPopularTV(apiKey, 1),
  getPopularTV(apiKey, 2),
  getPopularTV(apiKey, 3),
]);

// --- Build New Releases row ---
// Blend movies + TV, deduplicate by TMDB ID, sort by popularity, take 20.
const newReleaseSeen = new Set<number>();
const newReleaseItems: TmdbTrendingItem[] = [];
for (const item of [
  ...(newMoviesData?.results ?? []),
  ...(newTvData?.results ?? []),
]) {
  if (!newReleaseSeen.has(item.id)) {
    newReleaseSeen.add(item.id);
    newReleaseItems.push(item);
  }
}
newReleaseItems.sort((a, b) => b.popularity - a.popularity);
const newReleases = newReleaseItems.slice(0, 20);

// Track curated IDs so the grid below doesn't repeat them.
const curatedIds = new Set<number>();
for (const item of newReleases) curatedIds.add(item.id);

// --- Build grid (cross-deduplicated against curated rows) ---
const gridSeen = new Set<number>();
const gridItems: TmdbTrendingItem[] = [];

for (const result of [
  ...(gridMovies1?.results ?? []),
  ...(gridMovies2?.results ?? []),
  ...(gridMovies3?.results ?? []),
  ...(gridTv1?.results ?? []),
  ...(gridTv2?.results ?? []),
  ...(gridTv3?.results ?? []),
]) {
  // Skip titles already in curated rows or already seen in grid
  if (!curatedIds.has(result.id) && !gridSeen.has(result.id)) {
    gridSeen.add(result.id);
    gridItems.push(result);
  }
}

gridItems.sort((a, b) => b.popularity - a.popularity);
gridItems.length = Math.min(gridItems.length, 60);

// --- Score everything in one batch ---
// Combine curated + grid items for a single getScoresBatched call
// to minimize MDbList API calls and maximize KV cache hits.
const allItems = [...newReleases, ...gridItems];

const scoreInputs = allItems.map((item) => ({
  tmdbId: item.id,
  mediaType: (item.media_type ?? "movie") as "movie" | "tv",
  releaseDate: getReleaseDate(item) ?? null,
}));

const allScoreData = await getScoresBatched(kv, mdblistKey, scoreInputs);

// Map scores back to items
const allScored = allItems.map((item, i) => {
  const scoreData = allScoreData[i];
  const result = scoreData ? calculateReelScore(scoreData.scores) : null;
  return {
    item,
    score: result?.score ?? null,
    sources: result?.sources ?? [],
  };
});

// Split scored results back into curated row and grid
const newReleasesScored = allScored.slice(0, newReleases.length);
const gridScored = allScored.slice(newReleases.length);

// Build exclude list for page 2+ cross-dedup (comma-separated TMDB IDs)
const excludeParam = Array.from(curatedIds).join(",");
---

<Layout title="Home">
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {/* --- Curated Horizontal Rows --- */}

    {newReleasesScored.length > 0 && (
      <CuratedRow title="New Releases">
        {newReleasesScored.map(({ item, score, sources }) => (
          <div class="flex-shrink-0 w-36 sm:w-40">
            <TitleCard
              tmdbId={item.id}
              title={getDisplayTitle(item)}
              posterPath={item.poster_path}
              mediaType={(item.media_type ?? "movie") as "movie" | "tv"}
              releaseDate={getReleaseDate(item)}
              score={score}
              sources={sources}
              voteCount={item.vote_count}
            />
          </div>
        ))}
      </CuratedRow>
    )}

    {/* --- Blended Infinite Scroll Grid --- */}
    {/* Cross-deduplicated: curated row IDs excluded from grid.
        The exclude param passes curated IDs to page 2+ requests
        so the feed API can continue filtering them out. */}

    <FeedSection
      title="Discover"
      section="feed"
      loadMoreUrl={`/api/feed?page=2&exclude=${excludeParam}`}
    >
      {gridScored.map(({ item, score, sources }) => (
        <TitleCard
          tmdbId={item.id}
          title={getDisplayTitle(item)}
          posterPath={item.poster_path}
          mediaType={(item.media_type ?? "movie") as "movie" | "tv"}
          releaseDate={getReleaseDate(item)}
          score={score}
          sources={sources}
          voteCount={item.vote_count}
        />
      ))}
    </FeedSection>
  </main>
</Layout>
