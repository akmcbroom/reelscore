---
/**
 * Home page — Unified discovery feed.
 * Blends Trending + Now Playing + On The Air + Upcoming from TMDB,
 * deduplicates by TMDB ID, and sorts by popularity.
 * Renders initial data server-side, then uses HTMX for pagination.
 * See CLAUDE.md Discovery Feeds.
 */

import Layout from "../layouts/Layout.astro";
import TitleCard from "../components/TitleCard.astro";
import FeedSection from "../components/FeedSection.astro";
import {
  getTrending,
  getNowPlaying,
  getOnTheAir,
  getUpcoming,
  getDisplayTitle,
  getReleaseDate,
  type TmdbTrendingItem,
} from "../lib/tmdb.ts";
import { getScoresBatched } from "../lib/mdblist.ts";
import { calculateReelScore } from "../lib/scoring.ts";
import { env } from "cloudflare:workers";

const apiKey = env.TMDB_API_KEY;
const mdblistKey = env.MDBLIST_API_KEY;
const kv = env.SCORE_CACHE;

// Fetch page 1 from all TMDB sources in parallel
const [trendingData, nowPlayingData, onTheAirData, upcomingData] = await Promise.all([
  getTrending(apiKey, 1),
  getNowPlaying(apiKey, 1),
  getOnTheAir(apiKey, 1),
  getUpcoming(apiKey, 1),
]);

// Blend and deduplicate by TMDB ID
const seen = new Set<number>();
const combined: TmdbTrendingItem[] = [];

for (const result of [
  ...(trendingData?.results ?? []),
  ...(nowPlayingData?.results ?? []),
  ...(onTheAirData?.results ?? []),
  ...(upcomingData?.results ?? []),
]) {
  if (!seen.has(result.id)) {
    seen.add(result.id);
    combined.push(result);
  }
}

// Sort by popularity descending
combined.sort((a, b) => b.popularity - a.popularity);

// Fetch scores in rate-limited batches
const scoreInputs = combined.map((item) => ({
  tmdbId: item.id,
  mediaType: (item.media_type ?? "movie") as "movie" | "tv",
  releaseDate: getReleaseDate(item) ?? null,
}));

const allScoreData = await getScoresBatched(kv, mdblistKey, scoreInputs);

// Calculate ReelScores from fetched data
const scoredItems = combined.map((item, i) => {
  const scoreData = allScoreData[i];
  const result = scoreData ? calculateReelScore(scoreData.scores) : null;

  return {
    item,
    score: result?.score ?? null,
    sources: result?.sources ?? [],
  };
});
---

<Layout title="Home">
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <FeedSection
      section="feed"
      loadMoreUrl="/api/feed?page=2"
    >
      {scoredItems.map(({ item, score, sources }) => (
        <TitleCard
          tmdbId={item.id}
          title={getDisplayTitle(item)}
          posterPath={item.poster_path}
          mediaType={(item.media_type ?? "movie") as "movie" | "tv"}
          releaseDate={getReleaseDate(item)}
          score={score}
          sources={sources}
          voteCount={item.vote_count}
        />
      ))}
    </FeedSection>
  </main>
</Layout>
