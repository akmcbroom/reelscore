---
interface Props {
  title?: string;
}

const { title = "ReelScore" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Watch what you like, not what the critics like." />
    <title>{title} | ReelScore</title>
    {/* Tailwind v4 CDN — dev only, enables live class testing in browser devtools */}
    {import.meta.env.DEV && <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>}
  </head>
  <body class="min-h-screen bg-surface-900 text-white antialiased" x-data>
    <slot />

    <!-- Title Modal — Basecoat Dialog + Alpine.js state -->
    <!-- Opens inline when a title card is clicked. Content loaded via HTMX. -->
    <!-- URL-param driven: ?title=12345&type=movie — see CLAUDE.md Title Modal -->
    <div
      x-data
      x-show="$store.titleModal.open"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @keydown.escape.window="$store.titleModal.close()"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 md:p-10"
      style="display: none;"
    >
      <!-- Backdrop overlay -->
      <div
        class="fixed inset-0 bg-black/70"
        @click="$store.titleModal.close()"
      ></div>

      <!-- Modal panel -->
      <div
        class="relative w-full max-w-2xl max-h-[calc(100vh-2rem)] sm:max-h-[calc(100vh-3rem)] md:max-h-[calc(100vh-5rem)] flex flex-col rounded-lg bg-surface-800 shadow-2xl overflow-hidden"
        x-show="$store.titleModal.open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95 translate-y-4"
        x-transition:enter-end="opacity-100 scale-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 scale-100 translate-y-0"
        x-transition:leave-end="opacity-0 scale-95 translate-y-4"
        @click.stop
      >
        <!-- HTMX loads title content here — flex child so inner content can scroll -->
        <div id="title-modal-content" class="flex flex-col flex-1 min-h-0">
          <!-- Loading skeleton -->
          <div class="p-8 flex items-center justify-center">
            <div class="spinner"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trailer Modal — YouTube embed overlay -->
    <div
      x-data
      x-show="$store.titleModal.showTrailer"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @keydown.escape.window="$store.titleModal.showTrailer = false"
      class="fixed inset-0 z-[60] flex items-center justify-center p-4"
      style="display: none;"
    >
      <div class="fixed inset-0 bg-black/90" @click="$store.titleModal.showTrailer = false"></div>
      <div class="relative w-full max-w-4xl aspect-video" @click.stop>
        <button
          @click="$store.titleModal.showTrailer = false"
          class="absolute -top-10 right-0 text-white/70 hover:text-white"
          aria-label="Close trailer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
        <template x-if="$store.titleModal.showTrailer && $store.titleModal.trailerKey">
          <iframe
            :src="`https://www.youtube.com/embed/${$store.titleModal.trailerKey}?autoplay=1&rel=0`"
            class="w-full h-full rounded-lg"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        </template>
      </div>
    </div>

    <!-- Overview Modal — full description overlay -->
    <div
      x-data
      x-show="$store.titleModal.showOverview"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @keydown.escape.window="$store.titleModal.showOverview = false"
      class="fixed inset-0 z-[60] flex items-center justify-center p-4"
      style="display: none;"
    >
      <div class="fixed inset-0 bg-black/80" @click="$store.titleModal.showOverview = false"></div>
      <div class="relative w-full max-w-lg rounded-lg bg-surface-800 shadow-2xl p-6 max-h-[80vh] overflow-y-auto" @click.stop>
        <button
          @click="$store.titleModal.showOverview = false"
          class="absolute top-3 right-3 text-white/50 hover:text-white transition-colors"
          aria-label="Close overview"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
        <h3 class="text-lg font-semibold text-white mb-3">Overview</h3>
        <p class="text-sm text-white/70 leading-relaxed" x-text="$store.titleModal.overviewText"></p>
      </div>
    </div>

    <!-- Episode Detail Modal — mirrors main modal with still image background -->
    <div
      x-data
      x-show="$store.titleModal.showEpisode"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @keydown.escape.window="$store.titleModal.showEpisode = false"
      class="fixed inset-0 z-[60] flex items-center justify-center p-4"
      style="display: none;"
    >
      <div class="fixed inset-0 bg-black/80" @click="$store.titleModal.showEpisode = false"></div>
      <div class="relative w-full max-w-lg rounded-lg bg-surface-800 shadow-2xl overflow-hidden" @click.stop>
        <!-- Still image background with gradient -->
        <div class="relative">
          <div class="h-48 sm:h-56 overflow-hidden">
            <img :src="$store.titleModal.episode.stillUrl" alt="" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-800 via-surface-800/60 to-transparent"></div>
          </div>
          <!-- Close button -->
          <button
            @click="$store.titleModal.showEpisode = false"
            class="absolute top-3 right-3 z-20 rounded-full bg-black/50 p-1.5 text-white/70 hover:text-white hover:bg-black/70 transition-colors"
            aria-label="Close"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
          <!-- Episode info overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
            <p class="text-xs text-white/50" x-text="$store.titleModal.episode.showTitle"></p>
            <h2 class="text-lg sm:text-xl font-bold text-white leading-tight mt-1" x-text="$store.titleModal.episode.title"></h2>
            <div class="mt-1.5 flex flex-wrap items-center">
              <span class="badge-secondary bg-white/10 backdrop-blur" x-text="$store.titleModal.episode.seasonEp"></span>
              <span class="badge-secondary bg-transparent" x-text="$store.titleModal.episode.airDate"></span>
              <span class="text-white/30" x-show="$store.titleModal.episode.runtime">&bull;</span>
              <span class="badge-secondary bg-transparent" x-text="$store.titleModal.episode.runtime"></span>
            </div>
          </div>
        </div>
        <!-- Description -->
        <div class="px-4 pb-4 sm:px-6 sm:pb-6">
          <p class="text-sm text-white/70 leading-relaxed" x-text="$store.titleModal.episode.overview"></p>
        </div>
      </div>
    </div>

    <script>
      import htmx from "htmx.org";
      import Alpine from "alpinejs";
      import "basecoat-css/all";

      // Expose htmx globally so Alpine store and HTMX-loaded content can access it
      (window as any).htmx = htmx;

      /**
       * Alpine store for title modal state.
       * Manages open/close, HTMX content loading, trailer overlay,
       * and URL param sync (?title=X&type=Y).
       */
      Alpine.store("titleModal", {
        open: false,
        tmdbId: null as number | null,
        mediaType: "movie" as "movie" | "tv",
        trailerKey: "" as string,
        showTrailer: false,
        showOverview: false,
        showEpisode: false,

        /** Full overview text — displayed in the overview modal */
        overviewText: "" as string,

        /** Episode detail modal state — populated by openEpisode() */
        episode: {
          stillUrl: "",
          showTitle: "",
          title: "",
          seasonEp: "",
          airDate: "",
          runtime: "",
          overview: "",
        },

        /**
         * Opens the modal for a given title. Updates URL params and
         * triggers HTMX to fetch the modal content.
         */
        openTitle(tmdbId: number, mediaType: string) {
          this.tmdbId = tmdbId;
          this.mediaType = mediaType as "movie" | "tv";
          this.open = true;
          this.showTrailer = false;
          this.showOverview = false;
          this.showEpisode = false;
          this.trailerKey = "";
          this.overviewText = "";

          // Update URL for shareability/bookmarking — see CLAUDE.md Title Modal
          const url = new URL(window.location.href);
          url.searchParams.set("title", String(tmdbId));
          url.searchParams.set("type", mediaType);
          history.pushState(null, "", url.toString());

          // Reset modal content to loading state
          const container = document.getElementById("title-modal-content");
          if (container) {
            container.innerHTML = `<div class="p-8 flex items-center justify-center"><div class="spinner"></div></div>`;
          }

          // Use HTMX to fetch the title content
          const htmx = (window as any).htmx;
          if (htmx && container) {
            htmx.ajax("GET", `/api/title/${tmdbId}?type=${mediaType}`, {
              target: "#title-modal-content",
              swap: "innerHTML",
            });
          }

          // Prevent body scroll while modal is open
          document.body.style.overflow = "hidden";
        },

        /**
         * Closes the modal and cleans up URL params.
         */
        close() {
          this.open = false;
          this.showTrailer = false;
          this.showOverview = false;
          this.showEpisode = false;
          this.trailerKey = "";
          this.overviewText = "";

          // Remove title/type params from URL
          const url = new URL(window.location.href);
          url.searchParams.delete("title");
          url.searchParams.delete("type");
          history.pushState(null, "", url.toString());

          // Restore body scroll
          document.body.style.overflow = "";
        },

        /**
         * Opens the full overview modal with the given text.
         */
        openOverview(text: string) {
          this.overviewText = text;
          this.showOverview = true;
        },

        /**
         * Opens the episode detail modal with the given episode data.
         */
        openEpisode(data: { stillUrl: string; showTitle: string; title: string; seasonEp: string; airDate: string; runtime: string; overview: string }) {
          this.episode = data;
          this.showEpisode = true;
        },
      });

      Alpine.start();

      // Re-initialize Alpine on HTMX-loaded content so @click directives work
      // on dynamically loaded title cards and modal content.
      document.body.addEventListener("htmx:afterSwap", (event: any) => {
        Alpine.initTree(event.detail.target);
      });

      // Check URL params on page load — open modal if ?title=X is present.
      // This makes the modal URL-shareable and bookmarkable.
      document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const titleId = params.get("title");
        const type = params.get("type") ?? "movie";
        if (titleId) {
          const store = Alpine.store("titleModal") as any;
          store.openTitle(parseInt(titleId, 10), type);
        }
      });

      // Handle browser back/forward — close or open modal based on URL params
      window.addEventListener("popstate", () => {
        const params = new URLSearchParams(window.location.search);
        const titleId = params.get("title");
        const store = Alpine.store("titleModal") as any;
        if (titleId) {
          const type = params.get("type") ?? "movie";
          store.openTitle(parseInt(titleId, 10), type);
        } else if (store.open) {
          store.open = false;
          store.showTrailer = false;
          document.body.style.overflow = "";
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
