---
interface Props {
  title?: string;
}

const { title = "ReelScore" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Watch what you like, not what the critics like." />
    <title>{title} | ReelScore</title>
    {/* Tailwind v4 CDN — dev only, enables live class testing in browser devtools */}
    {import.meta.env.DEV && <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>}
  </head>
  <body class="min-h-screen bg-surface-900 text-white antialiased">
    <slot />

    <!-- Title Modal — native <dialog>, content loaded via HTMX -->
    <!-- URL-param driven: ?title=12345&type=movie — see CLAUDE.md Title Modal -->
    <dialog
      id="title-modal"
      class="p-4 sm:p-6 md:p-10"
      onclick="if (event.target === this) window.titleModal.close()"
    >
      <div class="relative w-full max-w-2xl max-h-[calc(100vh-5rem)] flex flex-col rounded-lg bg-surface-800 shadow-2xl">
        <!-- HTMX loads title content here — flex child so inner content can scroll -->
        <div id="title-modal-content" class="flex flex-col flex-1 min-h-0">
          <!-- Loading skeleton shown until HTMX swaps in the title content -->
          <div class="p-8 flex items-center justify-center">
            <div class="spinner"></div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Trailer Modal — YouTube embed overlay -->
    <dialog
      id="trailer-modal"
      onclick="if (event.target === this) window.titleModal.closeTrailer()"
    >
      <div class="relative w-full max-w-4xl aspect-video" onclick="event.stopPropagation()">
        <button
          onclick="window.titleModal.closeTrailer()"
          class="absolute -top-10 right-0 text-white/70 hover:text-white"
          aria-label="Close trailer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
        <!-- src is set/cleared programmatically to start/stop playback -->
        <iframe
          id="trailer-iframe"
          class="w-full h-full rounded-lg"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>
    </dialog>

    <!-- Overview Modal — full description overlay -->
    <dialog
      id="overview-modal"
      class="p-4"
      onclick="if (event.target === this) this.close()"
    >
      <div class="relative w-full max-w-lg rounded-lg bg-surface-800 shadow-2xl p-6 max-h-[80vh] overflow-y-auto" onclick="event.stopPropagation()">
        <button
          onclick="document.getElementById('overview-modal').close()"
          class="absolute top-3 right-3 text-white/50 hover:text-white transition-colors"
          aria-label="Close overview"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
        <h3 class="text-lg font-semibold text-white mb-3">Overview</h3>
        <p id="overview-text" class="text-sm text-white/70 leading-relaxed"></p>
      </div>
    </dialog>

    <!-- Episode Detail Modal — still image background + episode info -->
    <dialog
      id="episode-modal"
      class="p-4"
      onclick="if (event.target === this) this.close()"
    >
      <div class="relative w-full max-w-lg rounded-lg bg-surface-800 shadow-2xl overflow-hidden" onclick="event.stopPropagation()">
        <!-- Still image background with gradient -->
        <div class="relative">
          <div class="h-48 sm:h-56 overflow-hidden">
            <img id="episode-still" src="" alt="" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-800 via-surface-800/60 to-transparent"></div>
          </div>
          <button
            onclick="document.getElementById('episode-modal').close()"
            class="absolute top-3 right-3 z-20 rounded-full bg-black/50 p-1.5 text-white/70 hover:text-white hover:bg-black/70 transition-colors"
            aria-label="Close"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
          <!-- Episode info overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
            <p id="episode-show-title" class="text-xs text-white/50"></p>
            <h2 id="episode-title" class="text-lg sm:text-xl font-bold text-white leading-tight mt-1"></h2>
            <div class="mt-1.5 flex flex-wrap items-center">
              <span id="episode-season-ep" class="badge-secondary bg-white/10 backdrop-blur"></span>
              <span id="episode-air-date" class="badge-secondary bg-transparent"></span>
              <span id="episode-runtime-dot" class="text-white/30 hidden">&bull;</span>
              <span id="episode-runtime" class="badge-secondary bg-transparent"></span>
            </div>
          </div>
        </div>
        <!-- Description -->
        <div class="px-4 pb-4 sm:px-6 sm:pb-6">
          <p id="episode-overview" class="text-sm text-white/70 leading-relaxed"></p>
        </div>
      </div>
    </dialog>

    <script>
      import htmx from "htmx.org";
      import "basecoat-css/all";

      // Expose htmx globally so HTMX-loaded partials can access it
      (window as any).htmx = htmx;

      /**
       * titleModal — vanilla JS modal controller.
       * Replaces the old Alpine store with direct DOM manipulation.
       * Manages open/close for the title, trailer, overview, and episode dialogs.
       * URL param sync (?title=X&type=Y) for shareable/bookmarkable modal state.
       */
      const titleModal = {
        /**
         * Opens the title modal for a given TMDB ID.
         * Resets content to loading state, fetches via HTMX, updates URL.
         */
        openTitle(tmdbId: number, mediaType: string) {
          const url = new URL(window.location.href);
          url.searchParams.set("title", String(tmdbId));
          url.searchParams.set("type", mediaType);
          history.pushState(null, "", url.toString());

          // Reset to loading skeleton while HTMX fetches the title content
          const container = document.getElementById("title-modal-content");
          if (container) {
            container.innerHTML = `<div class="p-8 flex items-center justify-center"><div class="spinner"></div></div>`;
          }

          const htmxInst = (window as any).htmx;
          if (htmxInst && container) {
            htmxInst.ajax("GET", `/api/title/${tmdbId}?type=${mediaType}`, {
              target: "#title-modal-content",
              swap: "innerHTML",
            });
          }

          const dialog = document.getElementById("title-modal") as HTMLDialogElement;
          if (dialog && !dialog.open) {
            dialog.showModal();
            document.body.style.overflow = "hidden";
          }
        },

        /** Closes the title modal. The 'close' event handler restores scroll + URL. */
        close() {
          const dialog = document.getElementById("title-modal") as HTMLDialogElement;
          if (dialog?.open) dialog.close();
        },

        /** Opens the trailer modal. Sets iframe src to start autoplay. */
        openTrailer(key: string) {
          const iframe = document.getElementById("trailer-iframe") as HTMLIFrameElement;
          if (iframe) iframe.src = `https://www.youtube.com/embed/${key}?autoplay=1&rel=0`;
          const dialog = document.getElementById("trailer-modal") as HTMLDialogElement;
          dialog?.showModal();
        },

        /** Closes the trailer modal and clears iframe src to stop playback. */
        closeTrailer() {
          const dialog = document.getElementById("trailer-modal") as HTMLDialogElement;
          dialog?.close();
          const iframe = document.getElementById("trailer-iframe") as HTMLIFrameElement;
          if (iframe) iframe.src = "";
        },

        /** Opens the full overview modal with the given text. */
        openOverview(text: string) {
          const el = document.getElementById("overview-text");
          if (el) el.textContent = text;
          const dialog = document.getElementById("overview-modal") as HTMLDialogElement;
          dialog?.showModal();
        },

        /** Opens the episode detail modal, populating all fields from episode data. */
        openEpisode(data: {
          stillUrl: string; showTitle: string; title: string;
          seasonEp: string; airDate: string; runtime: string; overview: string;
        }) {
          const still = document.getElementById("episode-still") as HTMLImageElement;
          if (still) still.src = data.stillUrl;
          (document.getElementById("episode-show-title") as HTMLElement).textContent = data.showTitle;
          (document.getElementById("episode-title") as HTMLElement).textContent = data.title;
          (document.getElementById("episode-season-ep") as HTMLElement).textContent = data.seasonEp;
          (document.getElementById("episode-air-date") as HTMLElement).textContent = data.airDate;
          (document.getElementById("episode-runtime") as HTMLElement).textContent = data.runtime;
          (document.getElementById("episode-runtime-dot") as HTMLElement).classList.toggle("hidden", !data.runtime);
          (document.getElementById("episode-overview") as HTMLElement).textContent = data.overview;
          const dialog = document.getElementById("episode-modal") as HTMLDialogElement;
          dialog?.showModal();
        },
      };

      // Expose globally so inline onclick handlers on dialog elements can call it
      (window as any).titleModal = titleModal;

      /**
       * Single delegated click listener — handles all interactive elements.
       * Works for both static and HTMX-loaded content without re-initialization.
       *
       * Dispatch order:
       *   1. data-action="close-modal"    — close title modal
       *   2. data-action="open-overview"  — open overview (data-text)
       *   3. data-action="open-trailer"   — open trailer (data-key)
       *   4. data-action="open-episode"   — open episode modal (data-episode JSON)
       *   5. [data-season-btn]            — update active season pill
       *   6. [data-tmdb-id] outside dialog — open title modal
       */
      document.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as HTMLElement;

        // data-action dispatch
        const actionEl = target.closest("[data-action]") as HTMLElement | null;
        if (actionEl) {
          const action = actionEl.dataset.action;
          if (action === "close-modal") titleModal.close();
          else if (action === "open-overview") titleModal.openOverview(actionEl.dataset.text ?? "");
          else if (action === "open-trailer") titleModal.openTrailer(actionEl.dataset.key ?? "");
          else if (action === "open-episode") {
            try { titleModal.openEpisode(JSON.parse(actionEl.dataset.episode ?? "{}")); } catch {}
          }
          return;
        }

        // Season pill — update active class; HTMX handles the server fetch
        const seasonBtn = target.closest("[data-season-btn]") as HTMLElement | null;
        if (seasonBtn) {
          const section = seasonBtn.closest(".seasons-section");
          section?.querySelectorAll<HTMLElement>("[data-season-btn]").forEach((btn) => {
            btn.className = "flex-shrink-0 rounded-full px-3 py-1 text-xs font-medium transition-colors bg-surface-600 text-white/60 hover:bg-surface-500 hover:text-white/80";
          });
          seasonBtn.className = "flex-shrink-0 rounded-full px-3 py-1 text-xs font-medium transition-colors bg-white text-black";
          return;
        }

        // Title card — any element with data-tmdb-id that is NOT inside a dialog
        const card = target.closest("[data-tmdb-id]") as HTMLElement | null;
        if (card && !card.closest("dialog")) {
          const id = parseInt(card.dataset.tmdbId ?? "", 10);
          const type = card.dataset.mediaType ?? "movie";
          if (!isNaN(id)) titleModal.openTitle(id, type);
        }
      });

      // Restore body scroll and clean URL when title modal closes (Escape key too)
      document.getElementById("title-modal")?.addEventListener("close", () => {
        document.body.style.overflow = "";
        const url = new URL(window.location.href);
        if (url.searchParams.has("title")) {
          url.searchParams.delete("title");
          url.searchParams.delete("type");
          history.pushState(null, "", url.toString());
        }
      });

      // Clear trailer iframe on close to stop video playback
      document.getElementById("trailer-modal")?.addEventListener("close", () => {
        const iframe = document.getElementById("trailer-iframe") as HTMLIFrameElement;
        if (iframe) iframe.src = "";
      });

      // Check URL params on page load — open modal if ?title=X is present
      document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const titleId = params.get("title");
        const type = params.get("type") ?? "movie";
        if (titleId) titleModal.openTitle(parseInt(titleId, 10), type);
      });

      // Handle browser back/forward — restore modal state from URL
      window.addEventListener("popstate", () => {
        const params = new URLSearchParams(window.location.search);
        const titleId = params.get("title");
        const dialog = document.getElementById("title-modal") as HTMLDialogElement;
        if (titleId) {
          titleModal.openTitle(parseInt(titleId, 10), params.get("type") ?? "movie");
        } else if (dialog?.open) {
          dialog.close();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
