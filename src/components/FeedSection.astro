---
/**
 * FeedSection — A grid of title cards with HTMX infinite scroll.
 * Used on the home page for the unified discovery feed.
 *
 * @prop title - Section heading (optional, omit for no heading)
 * @prop section - Feed section ID for HTMX loading
 * @prop loadMoreUrl - URL for infinite scroll (HTMX endpoint)
 */

interface Props {
  title?: string;
  section: string;
  loadMoreUrl?: string;
}

const { title, section, loadMoreUrl } = Astro.props;
---

<section class="py-6" id={`feed-${section}`}>
  {title && (
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-bold text-white">{title}</h2>
    </div>
  )}

  {/* Card grid — responsive: 2 cols on mobile, up to 6 on desktop.
      The scroll sentinel lives inside the grid as the last child so
      it participates in grid flow and IntersectionObserver can track it. */}
  <div
    class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
    id={`grid-${section}`}
  >
    <slot />

    {/* Scroll sentinel — triggers the next page fetch via IntersectionObserver.
        Uses "intersect threshold:0.1" instead of "revealed" because "revealed"
        fires immediately on DOM insertion (before layout), causing runaway loading.
        "intersect" only fires when the element is actually scrolled into view.
        Spans the full grid width so it has a real box for IO to observe. */}
    {loadMoreUrl && (
      <div
        style="grid-column: 1 / -1; height: 1px;"
        hx-get={loadMoreUrl}
        hx-trigger="intersect threshold:0.1 once"
        hx-target={`#grid-${section}`}
        hx-swap="beforeend"
      />
    )}
  </div>
</section>
