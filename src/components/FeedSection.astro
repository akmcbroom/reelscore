---
/**
 * FeedSection — A labeled section of title cards in a horizontal-scroll or grid layout.
 * Used on the home page for Trending, New Releases, In Theaters, etc.
 *
 * @prop title - Section heading (e.g., "Trending")
 * @prop section - Feed section ID for HTMX loading (e.g., "trending")
 * @prop loadMoreUrl - URL for infinite scroll / "load more" (HTMX endpoint)
 */

interface Props {
  title: string;
  section: string;
  loadMoreUrl?: string;
}

const { title, section, loadMoreUrl } = Astro.props;
---

<section class="py-6" id={`feed-${section}`}>
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-bold text-white">{title}</h2>
  </div>

  {/* Card grid — responsive: 2 cols on mobile, up to 6 on desktop */}
  <div
    class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
    id={`grid-${section}`}
  >
    <slot />
  </div>

  {/* Load more trigger — HTMX infinite scroll */}
  {loadMoreUrl && (
    <div
      class="mt-6 flex justify-center"
      hx-get={loadMoreUrl}
      hx-trigger="revealed"
      hx-target={`#grid-${section}`}
      hx-swap="beforeend"
    >
      <span class="badge-outline text-white/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
        Loading more...
      </span>
    </div>
  )}
</section>
