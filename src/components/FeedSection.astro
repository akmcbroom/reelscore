---
/**
 * FeedSection — A grid of title cards with HTMX infinite scroll.
 * Used on the home page for the unified discovery feed.
 *
 * @prop title - Section heading (optional, omit for no heading)
 * @prop section - Feed section ID for HTMX loading
 * @prop loadMoreUrl - URL for infinite scroll (HTMX endpoint)
 */

interface Props {
  title?: string;
  section: string;
  loadMoreUrl?: string;
}

const { title, section, loadMoreUrl } = Astro.props;
---

<section class="py-6" id={`feed-${section}`}>
  {title && (
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-bold text-white">{title}</h2>
    </div>
  )}

  {/* Card grid — responsive: 2 cols on mobile, up to 6 on desktop.
      Wrapped in a relative container so the absolute-positioned sentinel
      doesn't affect grid layout. */}
  <div class="relative">
    <div
      class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
      id={`grid-${section}`}
    >
      <slot />
    </div>

    {/* Invisible sentinel — positioned absolute so it doesn't create a grid
        row or gap. Still in the DOM flow for HTMX's "revealed" trigger to fire
        when the user scrolls near the bottom. Cards are appended directly into
        the grid via hx-target + hx-swap="beforeend". */}
    {loadMoreUrl && (
      <div
        class="absolute bottom-0 h-px w-px"
        hx-get={loadMoreUrl}
        hx-trigger="revealed"
        hx-target={`#grid-${section}`}
        hx-swap="beforeend"
      />
    )}
  </div>
</section>
