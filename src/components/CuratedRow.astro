---
/**
 * CuratedRow — Horizontal scrollable row of title cards.
 * Used on the home page for curated sections (In Theaters, Trending, etc.).
 * Same scroll pattern as episode/cast carousels (flex + overflow-x-auto + scrollbar-hide).
 * See CLAUDE.md Discovery Feed > Curated Horizontal Rows.
 *
 * @prop title - Section heading
 */

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="py-4">
  <h2 class="mb-3 text-lg font-bold text-white">{title}</h2>
  <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
    <slot />
  </div>
</section>
