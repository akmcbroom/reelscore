---
/**
 * TitleCard — Media card displaying poster, score pill, title, and metadata.
 * This is the primary card used across the discovery feed.
 * See CLAUDE.md Title Card for the full spec.
 *
 * @prop tmdbId - TMDB title ID
 * @prop title - Display title
 * @prop posterPath - TMDB poster path (or null for placeholder)
 * @prop mediaType - "movie" or "tv"
 * @prop releaseDate - ISO date string
 * @prop score - ReelScore value (0-100) or null
 * @prop sources - Individual source scores for dev tooltip
 * @prop voteCount - TMDB vote count (for display context)
 */

import { getImageUrl } from "../lib/tmdb.ts";
import { getSourceLabel } from "../lib/scoring.ts";
import type { NormalizedScore } from "../lib/mdblist.ts";

interface Props {
  tmdbId: number;
  title: string;
  posterPath: string | null;
  mediaType: "movie" | "tv";
  releaseDate?: string;
  score: number | null;
  sources?: NormalizedScore[];
  voteCount?: number;
}

const { tmdbId, title, posterPath, mediaType, releaseDate, score, sources = [], voteCount } = Astro.props;

const posterUrl = getImageUrl(posterPath, "poster", "medium");
const year = releaseDate ? new Date(releaseDate).getFullYear() : null;
const typeBadgeText = mediaType === "tv" ? "TV Show" : "Movie";

// Unreleased titles show a clock icon instead of a score — release date
// is compared at render time. See CLAUDE.md Title Card and ScoreBadge.
const isUnreleased = releaseDate ? new Date(releaseDate) > new Date() : false;

// Score lip gradient colors — each tier has a light (top) and dark (bottom) hex.
// Used for both the Tailwind gradient on the tab and SVG linearGradient on the curves.
type ScoreTier = { from: string; to: string; fromClass: string; toClass: string; borderClass: string; textColor: string };
const scoreTiers: Record<string, ScoreTier> = {
  green: { from: "#22c55e", to: "#166534", fromClass: "from-green-500", toClass: "to-green-800", borderClass: "border-green-800", textColor: "text-white/90" },
  gold:  { from: "#f59e0b", to: "#92400e", fromClass: "from-amber-500", toClass: "to-amber-800", borderClass: "border-amber-800", textColor: "text-white/90" },
  red:   { from: "#ef4444", to: "#991b1b", fromClass: "from-red-500",   toClass: "to-red-800",   borderClass: "border-red-800",   textColor: "text-white/90" },
  none:  { from: "#525252", to: "#262626", fromClass: "from-neutral-600", toClass: "to-neutral-800", borderClass: "border-neutral-800", textColor: "text-white/60" },
};

let tier: ScoreTier;
if (isUnreleased || score === null) tier = scoreTiers.none;
else if (score >= 70) tier = scoreTiers.green;
else if (score >= 60) tier = scoreTiers.gold;
else tier = scoreTiers.red;

// Unique SVG gradient IDs per card — prevents conflicts when 60+ cards render on one page
const gradL = `grad-l-${tmdbId}`;
const gradR = `grad-r-${tmdbId}`;

// Dev tooltip with source breakdown — same as ScoreBadge behavior
const isDev = import.meta.env.DEV;
let scoreTitle = isUnreleased
  ? "Not yet released"
  : score !== null
    ? `ReelScore: ${score}`
    : "Not enough ratings";
if (isDev && sources.length > 0) {
  const breakdown = sources
    .map((s) => `${getSourceLabel(s.source)}: ${s.normalizedScore}`)
    .join(" | ");
  scoreTitle = score !== null
    ? `ReelScore: ${score} (${sources.length} sources)\n${breakdown}`
    : `Insufficient sources (${sources.length}/2)\n${breakdown}`;
}
---

<div
  class="group relative flex flex-col cursor-pointer"
  data-tmdb-id={tmdbId}
  data-media-type={mediaType}
  @click={`$store.titleModal.openTitle(${tmdbId}, '${mediaType}')`}
>
  <div class="flex flex-col relative">
    {/* Score lip — small gradient tab with concave SVG curves on both sides.
        Positioned right-aligned above the poster. The curves flow into the
        poster's top border, creating a seamless branded tab effect. */}
    <div class="flex items-end self-end mr-2">
      {/* Left concave curve */}
      <svg class="overflow-visible h-3" viewBox="0 0 14 14">
        <defs>
          <linearGradient id={gradL} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color={tier.from} />
            <stop offset="100%" stop-color={tier.to} />
          </linearGradient>
        </defs>
        <path d="M14,0 Q14,14 0,14 L14,14 Z" fill={`url(#${gradL})`} />
      </svg>

      {/* Score tab */}
      <div
        class:list={["flex items-center justify-center z-10 rounded-t-lg w-12 h-5 bg-gradient-to-b", tier.fromClass, tier.toClass]}
        title={scoreTitle}
      >
        <span class:list={["font-mono font-bold text-sm tabular-nums", tier.textColor]}>
          {isUnreleased ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          ) : score !== null ? score : "—"}
        </span>
      </div>

      {/* Right concave curve */}
      <svg class="overflow-visible h-3" viewBox="0 0 14 14">
        <defs>
          <linearGradient id={gradR} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color={tier.from} />
            <stop offset="100%" stop-color={tier.to} />
          </linearGradient>
        </defs>
        <path d="M0,0 Q0,14 14,14 L0,14 Z" fill={`url(#${gradR})`} />
      </svg>
    </div>

    {/* Poster — border-top matches the gradient's dark end for seamless connection */}
    <div class:list={["relative overflow-hidden bg-surface-700 aspect-[2/3] rounded-lg shadow-lg border-t-2", tier.borderClass]}>
      {posterUrl ? (
        <img
          src={posterUrl}
          alt={title}
          loading="lazy"
          width="342"
          height="513"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-white/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5" />
            <rect x="2" y="6" width="14" height="12" rx="2" />
          </svg>
        </div>
      )}
    </div>
  </div>

  {/* Title */}
  <h3 class="mt-2 text-sm font-medium text-white truncate leading-tight">
    {title}
  </h3>

  {/* Metadata row: type • year (matches modal style) */}
  <div class="mt-1 flex items-center gap-1 text-xs text-white/50">
    <span>{typeBadgeText}</span>
    {year && <><span>•</span><span>{year}</span></>}
  </div>
</div>
