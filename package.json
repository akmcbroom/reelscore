{
  "name": "reelscore",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "wrangler types src/worker-configuration.d.ts && svelte-kit sync && rm -rf .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "postinstall": "wrangler types src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply reelscore-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply reelscore-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.2",
    "@lucide/svelte": "1.25.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.63.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "22.20.1",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.10",
    "shadcn-svelte": "1.4.2",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
